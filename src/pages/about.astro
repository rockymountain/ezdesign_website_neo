---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/common/SectionHeader.astro';
import CTASection from '../components/common/CTASection.astro';
import Card from '../components/common/Card.astro';
import ButtonLink from '../components/common/ButtonLink.astro';

import pageContent from '../data/about.json';

type CTA = {
  label: string;
  href: string;
};

type ContentItem = {
  title: string;
  description: string;
};

type TeamMember = {
  name: string;
  role: string;
  description: string;
};

type SocialProofTestimonial = {
  quote: string;
  author: string;
  role: string;
};

const title = pageContent.seo.title;
const description = pageContent.seo.description;

const values = pageContent.values.items as ContentItem[];
const principles = pageContent.principles.items as ContentItem[];

const teamMembers = pageContent.team.members as TeamMember[];
const proofLogos = pageContent.socialProof.logos as string[];
const proofTestimonial = pageContent.socialProof.testimonial as SocialProofTestimonial;

const finalPrimaryCTA = pageContent.finalCTA.primaryCTA as CTA;
const finalSecondaryCTA = pageContent.finalCTA.secondaryCTA as CTA;
---

<BaseLayout title={title} description={description}>
  <main class="min-h-screen bg-[var(--ezd-bg)] text-[var(--ezd-text)]">
    <!-- Hero -->
    <section class="relative overflow-hidden border-b border-[var(--ezd-border)] bg-[var(--ezd-bg-soft)] py-20">
      <div
        class="pointer-events-none absolute -right-24 top-10 h-72 w-72 rounded-full bg-[var(--ezd-accent)] opacity-20 blur-3xl"
        aria-hidden="true"
      >
      </div>

      <div
        class="pointer-events-none absolute -left-24 bottom-0 h-72 w-72 rounded-full bg-[var(--ezd-brand)] opacity-10 blur-3xl"
        aria-hidden="true"
      >
      </div>

      <div class="ezd-container relative">
        <SectionHeader
          eyebrow={pageContent.hero.eyebrow}
          title={pageContent.hero.title}
          description={pageContent.hero.description}
          headingLevel="h1"
          maxWidth="xl"
        />
      </div>
    </section>

    <!-- Intro -->
    <section class="py-20">
      <div class="ezd-container">
        <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
          <SectionHeader
            eyebrow={pageContent.intro.eyebrow}
            title={pageContent.intro.title}
            maxWidth="lg"
          />

          <Card padding="lg">
            <p class="ezd-body-large text-[var(--ezd-text-muted)]">
              {pageContent.intro.description}
            </p>

            <div class="mt-8 grid gap-4 md:grid-cols-3">
              <div class="rounded-[var(--ezd-radius-xl)] bg-[var(--ezd-bg-soft)] p-5">
                <p class="text-xs font-black uppercase tracking-[0.2em] text-[var(--ezd-brand)]">
                  Easy
                </p>
                <p class="mt-3 text-sm font-black">Dễ hiểu</p>
              </div>

              <div class="rounded-[var(--ezd-radius-xl)] bg-[var(--ezd-bg-soft)] p-5">
                <p class="text-xs font-black uppercase tracking-[0.2em] text-[var(--ezd-brand)]">
                  Fast
                </p>
                <p class="mt-3 text-sm font-black">Nhanh triển khai</p>
              </div>

              <div class="rounded-[var(--ezd-radius-xl)] bg-[var(--ezd-bg-soft)] p-5">
                <p class="text-xs font-black uppercase tracking-[0.2em] text-[var(--ezd-brand)]">
                  Practical
                </p>
                <p class="mt-3 text-sm font-black">Phù hợp SME</p>
              </div>
            </div>
          </Card>
        </div>
      </div>
    </section>

    <!-- Core Values -->
    <section class="bg-[var(--ezd-bg-soft)] py-20">
      <div class="ezd-container">
        <SectionHeader
          eyebrow={pageContent.values.eyebrow}
          title={pageContent.values.title}
          maxWidth="lg"
        />

        <div class="mt-10 grid gap-5 md:grid-cols-3">
          {
            values.map((item: ContentItem, index: number) => (
              <Card hover padding="lg">
                <p class="text-xs font-black uppercase tracking-[0.22em] text-[var(--ezd-brand)]">
                  0{index + 1}
                </p>

                <h3 class="ezd-heading-card mt-4 text-2xl">
                  {item.title}
                </h3>

                <p class="ezd-body-small mt-4 text-[var(--ezd-text-muted)]">
                  {item.description}
                </p>
              </Card>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Social Proof -->
    <section class="py-20">
      <div class="ezd-container">
        <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
          <SectionHeader
            eyebrow={pageContent.socialProof.eyebrow}
            title={pageContent.socialProof.title}
            description={pageContent.socialProof.description}
            maxWidth="lg"
          />

          <div class="grid gap-5">
            <Card padding="lg">
              <p class="text-xs font-black uppercase tracking-[0.22em] text-[var(--ezd-brand)]">
                Logo placeholders
              </p>

              <div class="mt-6 grid gap-3 sm:grid-cols-2">
                {
                  proofLogos.map((logo: string) => (
                    <div class="flex min-h-20 items-center justify-center rounded-[var(--ezd-radius-xl)] border border-[var(--ezd-border)] bg-[var(--ezd-bg-soft)] px-4 text-center">
                      <p class="text-sm font-black text-[var(--ezd-text-muted)]">
                        {logo}
                      </p>
                    </div>
                  ))
                }
              </div>
            </Card>

            <Card
              padding="lg"
              class="relative overflow-hidden border border-[var(--ezd-border)] bg-[linear-gradient(135deg,rgba(204,251,241,0.38),rgba(239,246,255,0.9))]"
            >
              <div
                class="pointer-events-none absolute -right-20 -top-20 h-64 w-64 rounded-full bg-[var(--ezd-accent)] opacity-10 blur-3xl"
                aria-hidden="true"
              >
              </div>

              <div class="relative">
                <p class="text-xs font-black uppercase tracking-[0.22em] text-[var(--ezd-brand)]">
                  Testimonial placeholder
                </p>

                <blockquote class="ezd-heading-card mt-5 text-2xl text-[var(--ezd-text)] md:text-3xl">
                  “{proofTestimonial.quote}”
                </blockquote>

                <p class="mt-5 text-sm font-bold text-[var(--ezd-text-muted)]">
                  {proofTestimonial.author} — {proofTestimonial.role}
                </p>
              </div>
            </Card>
          </div>
        </div>
      </div>
    </section>

    <!-- Communication Principles -->
    <section class="bg-[var(--ezd-bg-soft)] py-20">
      <div class="ezd-container">
        <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
          <SectionHeader
            eyebrow={pageContent.principles.eyebrow}
            title={pageContent.principles.title}
            maxWidth="lg"
          />

          <div class="grid gap-5">
            {
              principles.map((item: ContentItem) => (
                <Card hover>
                  <h3 class="ezd-heading-card text-xl">
                    {item.title}
                  </h3>

                  <p class="ezd-body-small mt-3 text-[var(--ezd-text-muted)]">
                    {item.description}
                  </p>
                </Card>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Meet the Team -->
    <section class="py-20">
      <div class="ezd-container">
        <SectionHeader
          eyebrow={pageContent.team.eyebrow}
          title={pageContent.team.title}
          description={pageContent.team.description}
          maxWidth="xl"
        />

        <div class="mt-10 grid gap-5 md:grid-cols-3">
          {
            teamMembers.map((member: TeamMember) => (
              <Card hover padding="lg">
                <div class="flex h-24 w-24 items-center justify-center rounded-full bg-[var(--ezd-brand-soft)] text-2xl font-black text-[var(--ezd-brand)]">
                  {member.name
                    .split(' ')
                    .map((word: string) => word[0])
                    .join('')
                    .slice(0, 2)}
                </div>

                <h3 class="ezd-heading-card mt-6 text-2xl">
                  {member.name}
                </h3>

                <p class="mt-2 text-sm font-black text-[var(--ezd-brand)]">
                  {member.role}
                </p>

                <p class="ezd-body-small mt-4 text-[var(--ezd-text-muted)]">
                  {member.description}
                </p>
              </Card>
            ))
          }
        </div>
      </div>
    </section>

    <!-- EZD AI Chat Spotlight -->
    <section class="bg-[var(--ezd-bg-soft)] py-20">
      <div class="ezd-container">
        <Card padding="lg" class="relative overflow-hidden">
          <div
            class="pointer-events-none absolute -right-20 -top-20 h-64 w-64 rounded-full bg-[var(--ezd-accent)] opacity-20 blur-3xl"
            aria-hidden="true"
          >
          </div>

          <div
            class="pointer-events-none absolute -left-20 bottom-0 h-64 w-64 rounded-full bg-[var(--ezd-brand)] opacity-10 blur-3xl"
            aria-hidden="true"
          >
          </div>

          <div class="relative grid gap-10 lg:grid-cols-[1fr_0.9fr] lg:items-center">
            <div>
              <p class="ezd-eyebrow">Hero Product</p>

              <h2 class="ezd-heading-section mt-4 text-3xl md:text-5xl">
                EZD AI Chat là sản phẩm mũi nhọn trong định vị mới của EZDesign.
              </h2>

              <p class="ezd-body-large mt-5 text-[var(--ezd-text-muted)]">
                Sản phẩm giúp SMEs B2C có một nhân vật AI mang giọng thương hiệu,
                biết tư vấn khách, trả lời FAQ, thu lead và chuyển khách sang người thật khi cần.
              </p>

              <div class="mt-8">
                <ButtonLink
                  href="/ezd-ai-chat/"
                  label="Khám phá EZD AI Chat"
                  variant="primary"
                  size="lg"
                />
              </div>
            </div>

            <div class="rounded-[var(--ezd-radius-2xl)] bg-[var(--ezd-bg-soft)] p-6">
              <p class="text-xs font-black uppercase tracking-[0.22em] text-[var(--ezd-brand)]">
                AI Touchpoint
              </p>

              <div class="mt-5 space-y-4">
                <div class="max-w-[86%] rounded-2xl bg-white px-4 py-3 text-sm leading-6 text-[var(--ezd-text-muted)] shadow-[var(--ezd-shadow-sm)]">
                  Website không chỉ hiển thị thông tin.
                </div>

                <div class="ml-auto max-w-[86%] rounded-2xl bg-[var(--ezd-brand)] px-4 py-3 text-sm leading-6 text-white shadow-[var(--ezd-shadow-sm)]">
                  Website cần biết trò chuyện và tư vấn.
                </div>

                <div class="max-w-[86%] rounded-2xl bg-white px-4 py-3 text-sm leading-6 text-[var(--ezd-text-muted)] shadow-[var(--ezd-shadow-sm)]">
                  EZD AI Chat giúp biến website thành một điểm chạm biết dẫn dắt khách hàng.
                </div>
              </div>
            </div>
          </div>
        </Card>
      </div>
    </section>

    <!-- Final CTA -->
    <CTASection
      eyebrow={pageContent.finalCTA.eyebrow}
      title={pageContent.finalCTA.title}
      description={pageContent.finalCTA.description}
      primaryCTA={finalPrimaryCTA}
      secondaryCTA={finalSecondaryCTA}
    />
  </main>
</BaseLayout>