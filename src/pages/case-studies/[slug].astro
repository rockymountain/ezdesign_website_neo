---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/common/SectionHeader.astro';
import CTASection from '../../components/common/CTASection.astro';
import Card from '../../components/common/Card.astro';
import ButtonLink from '../../components/common/ButtonLink.astro';

import { getCollection, render, type CollectionEntry } from 'astro:content';
import { buildArticleSchema, buildBreadcrumbSchema } from '../../utils/schema';

type CaseStudyEntry = CollectionEntry<'case-studies'>;
type CaseStudyData = CaseStudyEntry['data'];

type CaseStudySolution = CaseStudyData['solution'][number];
type RelatedService = CaseStudyData['relatedServices'][number];

export async function getStaticPaths() {
  const caseStudies: CaseStudyEntry[] = await getCollection('case-studies');

  return caseStudies.map((caseStudy: CaseStudyEntry) => ({
    params: {
      slug: caseStudy.data.slug,
    },
    props: {
      caseStudy,
    },
  }));
}

type Props = {
  caseStudy: CaseStudyEntry;
};

const { caseStudy } = Astro.props as Props;
const { Content } = await render(caseStudy);

const {
  title,
  client,
  industry,
  product,
  summary,
  heroTitle,
  heroDescription,
  canPublicName,
  canPublicImages,
  canPublicMetrics,
  canPublicFlow,
  canPublicCharacter,
  hasTestimonial,
  challenge,
  solution,
  highlights,
  testimonial,
  relatedServices,
} = caseStudy.data;

const pageTitle = caseStudy.data.seoTitle;
const pageDescription = caseStudy.data.seoDescription;
const pageOgImage = caseStudy.data.ogImage;

const pageUrl = `/case-studies/${caseStudy.data.slug}/`;

const disclosureItems = [
  {
    label: 'Client name',
    value: canPublicName ? 'Public' : 'Limited',
  },
  {
    label: 'Images',
    value: canPublicImages ? 'Public' : 'Limited',
  },
  {
    label: 'Metrics',
    value: canPublicMetrics ? 'Public' : 'Limited',
  },
  {
    label: 'Flow',
    value: canPublicFlow ? 'Public' : 'Limited',
  },
  {
    label: 'Character',
    value: canPublicCharacter ? 'Public' : 'Limited',
  },
];

const jsonLd = [
  buildArticleSchema({
    headline: title,
    description: summary,
    url: pageUrl,
    image: pageOgImage,
  }),
  buildBreadcrumbSchema([
    {
      name: 'Home',
      url: '/',
    },
    {
      name: 'Case Studies',
      url: '/case-studies/yen-ai-chat/',
    },
    {
      name: title,
      url: pageUrl,
    },
  ]),
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage={pageOgImage}
  ogType="article"
  jsonLd={jsonLd}
>
  <main class="min-h-screen bg-[var(--ezd-bg)] text-[var(--ezd-text)]">
    <!-- Hero -->
    <section class="relative overflow-hidden border-b border-[var(--ezd-border)] bg-[var(--ezd-bg-soft)] py-20">
      <div
        class="pointer-events-none absolute -right-24 top-10 h-72 w-72 rounded-full bg-[var(--ezd-accent)] opacity-20 blur-3xl"
        aria-hidden="true"
      >
      </div>

      <div
        class="pointer-events-none absolute -left-24 bottom-0 h-72 w-72 rounded-full bg-[var(--ezd-brand)] opacity-10 blur-3xl"
        aria-hidden="true"
      >
      </div>

      <div class="ezd-container relative">
        <div class="grid gap-10 lg:grid-cols-[1fr_0.82fr] lg:items-center">
          <div>
            <p class="ezd-eyebrow">
              Case Study
            </p>

            <h1 class="ezd-heading-hero mt-5 max-w-4xl text-4xl md:text-6xl">
              {heroTitle}
            </h1>

            <p class="ezd-body-large mt-6 max-w-2xl text-[var(--ezd-text-muted)]">
              {heroDescription}
            </p>

            <div class="mt-8 flex flex-wrap gap-3">
              <span class="rounded-full bg-[var(--ezd-brand)] px-4 py-2 text-sm font-black text-white">
                {product}
              </span>

              <span class="rounded-full border border-[var(--ezd-border)] bg-white px-4 py-2 text-sm font-black text-[var(--ezd-text-muted)]">
                {industry}
              </span>

              <span class="rounded-full border border-[var(--ezd-border)] bg-white px-4 py-2 text-sm font-black text-[var(--ezd-text-muted)]">
                {client}
              </span>
            </div>
          </div>

          <Card padding="lg" class="relative overflow-hidden">
            <div
              class="pointer-events-none absolute -right-16 -top-16 h-52 w-52 rounded-full bg-[var(--ezd-accent)] opacity-20 blur-3xl"
              aria-hidden="true"
            >
            </div>

            <div class="relative">
              <p class="text-xs font-black uppercase tracking-[0.22em] text-[var(--ezd-brand)]">
                Case Summary
              </p>

              <h2 class="ezd-heading-card mt-4 text-3xl">
                {title}
              </h2>

              <p class="ezd-body-small mt-4 text-[var(--ezd-text-muted)]">
                {summary}
              </p>

              <div class="mt-6 grid gap-3">
                <div class="rounded-[var(--ezd-radius-xl)] bg-[var(--ezd-bg-soft)] p-4">
                  <p class="text-sm font-black text-[var(--ezd-text)]">
                    Brand assistant
                  </p>
                  <p class="mt-1 text-xs leading-5 text-[var(--ezd-text-muted)]">
                    AI đóng vai một điểm chạm biết trò chuyện, tư vấn và dẫn khách tới handoff phù hợp.
                  </p>
                </div>

                <div class="rounded-[var(--ezd-radius-xl)] bg-[var(--ezd-bg-soft)] p-4">
                  <p class="text-sm font-black text-[var(--ezd-text)]">
                    Privacy-aware
                  </p>
                  <p class="mt-1 text-xs leading-5 text-[var(--ezd-text-muted)]">
                    Case study chỉ công khai các phần được phép chia sẻ.
                  </p>
                </div>
              </div>
            </div>
          </Card>
        </div>
      </div>
    </section>

    <!-- Disclosure -->
    <section class="py-12">
      <div class="ezd-container">
        <div class="grid gap-3 md:grid-cols-5">
          {
            disclosureItems.map((item: { label: string; value: string }) => (
              <Card padding="sm" class="text-center">
                <p class="text-xs font-black uppercase tracking-[0.18em] text-[var(--ezd-text-soft)]">
                  {item.label}
                </p>

                <p
                  class:list={[
                    'mt-2 text-sm font-black',
                    item.value === 'Public'
                      ? 'text-[var(--ezd-brand)]'
                      : 'text-[var(--ezd-text-muted)]',
                  ]}
                >
                  {item.value}
                </p>
              </Card>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Overview / MDX Content -->
    <section class="py-20">
      <div class="ezd-container">
        <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
          <SectionHeader
            eyebrow="Overview"
            title="Bối cảnh triển khai và cách EZDesign tiếp cận bài toán."
            description="Case study giúp hình dung cách một AI brand assistant được thiết kế từ nhu cầu thật, dữ liệu thật và hành trình khách hàng cụ thể."
            maxWidth="lg"
          />

          <Card padding="lg">
            <article class="ezd-body text-[var(--ezd-text-muted)]">
              <Content />
            </article>
          </Card>
        </div>
      </div>
    </section>

    <!-- Challenge -->
    {
      challenge.length > 0 && (
        <section class="bg-[var(--ezd-bg-soft)] py-20">
          <div class="ezd-container">
            <SectionHeader
              eyebrow="Challenge"
              title="Những vấn đề cần giải quyết."
              description="Các điểm nghẽn này là lý do cần một điểm chạm AI được thiết kế có guardrail, giọng thương hiệu và luồng chuyển đổi rõ ràng."
              maxWidth="lg"
            />

            <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
              {challenge.map((item: string, index: number) => (
                <Card hover padding="lg">
                  <p class="text-xs font-black uppercase tracking-[0.22em] text-[var(--ezd-brand)]">
                    0{index + 1}
                  </p>

                  <p class="ezd-body-small mt-4 text-[var(--ezd-text-muted)]">
                    {item}
                  </p>
                </Card>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- Solution -->
    {
      solution.length > 0 && (
        <section class="py-20">
          <div class="ezd-container">
            <SectionHeader
              eyebrow="Solution"
              title="Giải pháp được thiết kế theo vai trò của thương hiệu."
              description="EZDesign không chỉ dựng một chatbot trả lời FAQ, mà thiết kế một nhân vật AI có tone, flow và điểm chuyển tiếp sang người thật."
              maxWidth="lg"
            />

            <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
              {solution.map((item: CaseStudySolution) => (
                <Card hover padding="lg">
                  <h3 class="ezd-heading-card text-2xl">
                    {item.title}
                  </h3>

                  <p class="ezd-body-small mt-4 text-[var(--ezd-text-muted)]">
                    {item.description}
                  </p>
                </Card>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- Highlights -->
    {
      highlights.length > 0 && (
        <section class="bg-[var(--ezd-bg-soft)] py-20">
          <div class="ezd-container">
            <SectionHeader
              eyebrow="Highlights"
              title="Những điểm nổi bật trong case."
              description="Các điểm này cho thấy AI brand assistant có thể trở thành một phần của trải nghiệm thương hiệu, không chỉ là một tiện ích trả lời tự động."
              maxWidth="lg"
            />

            <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
              {highlights.map((item: string) => (
                <Card hover padding="lg">
                  <p class="ezd-body-small text-[var(--ezd-text-muted)]">
                    {item}
                  </p>
                </Card>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- Testimonial -->
    {
      hasTestimonial && testimonial && (
        <section class="py-20">
          <div class="ezd-container">
            <Card padding="lg" class="relative overflow-hidden bg-[var(--ezd-black)] text-white">
              <div
                class="pointer-events-none absolute -right-20 -top-20 h-64 w-64 rounded-full bg-[var(--ezd-accent)] opacity-20 blur-3xl"
                aria-hidden="true"
              >
              </div>

              <div class="relative max-w-4xl">
                <p class="text-xs font-black uppercase tracking-[0.22em] text-white/70">
                  Testimonial
                </p>

                <blockquote class="ezd-heading-section mt-5 text-3xl text-white md:text-5xl">
                  “{testimonial.quote}”
                </blockquote>

                {
                  (testimonial.name || testimonial.role) && (
                    <p class="mt-6 text-sm font-bold text-white/70">
                      {testimonial.name}
                      {testimonial.role && ` — ${testimonial.role}`}
                    </p>
                  )
                }
              </div>
            </Card>
          </div>
        </section>
      )
    }

    <!-- Related Services -->
    {
      relatedServices.length > 0 && (
        <section class="bg-[var(--ezd-bg-soft)] py-20">
          <div class="ezd-container">
            <SectionHeader
              eyebrow="Related Services"
              title="Các dịch vụ liên quan trong hệ sinh thái EZDesign."
              description="Một case thường kết hợp nhiều lớp: AI character, website tương tác, lead flow, analytics và các điểm chạm hỗ trợ chiến dịch."
              maxWidth="lg"
            />

            <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
              {relatedServices.map((service: RelatedService) => (
                <a href={service.href} class="block">
                  <Card hover padding="lg" class="h-full">
                    <p class="text-xs font-black uppercase tracking-[0.22em] text-[var(--ezd-brand)]">
                      Service
                    </p>

                    <h3 class="ezd-heading-card mt-4 text-2xl">
                      {service.title}
                    </h3>

                    <p class="mt-6 text-sm font-black text-[var(--ezd-brand)]">
                      Xem dịch vụ →
                    </p>
                  </Card>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- Final CTA -->
    <CTASection
      eyebrow="Start"
      title="Muốn tạo một case tương tự cho thương hiệu của bạn?"
      description="Đặt lịch demo để EZDesign tư vấn cách thiết kế AI brand assistant, lead flow và handoff phù hợp với website hiện tại của bạn."
      primaryCTA={{
        label: 'Đặt lịch demo',
        href: '/contact/',
      }}
      secondaryCTA={{
        label: 'Xem EZD AI Chat',
        href: '/ezd-ai-chat/',
      }}
    />
  </main>
</BaseLayout>