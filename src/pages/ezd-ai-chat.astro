---
import BaseLayout from '../layouts/BaseLayout.astro';

import ProductHero from '../components/sections/ProductHero.astro';
import PainPointGrid from '../components/sections/PainPointGrid.astro';
import FeatureGrid from '../components/sections/FeatureGrid.astro';
import UseCaseGrid from '../components/sections/UseCaseGrid.astro';
import FeatureSpotlight from '../components/sections/FeatureSpotlight.astro';
import PricingGrid from '../components/sections/PricingGrid.astro';
import FAQGrid from '../components/sections/FAQGrid.astro';
import CTASection from '../components/common/CTASection.astro';
import Card from '../components/common/Card.astro';

import pageContent from '../data/ezd-ai-chat.json';
import pricingData from '../data/pricing.json';
import industriesData from '../data/industries.json';

type ChatMessage = {
  role: 'assistant' | 'user';
  text: string;
};

type PricingPlan = {
  name: string;
  priceLabel: string;
  description: string;
  features: string[];
  isRecommended?: boolean;
};

type Industry = {
  name?: string;
  title?: string;
  description: string;
};

const title = pageContent.seo.title;
const description = pageContent.seo.description;

const heroPreviewMessages = pageContent.hero.previewMessages as ChatMessage[];

const ezdAiChatPlans = pricingData.ezdAiChatPricing as PricingPlan[];
const pricingNote = pricingData.pricingNote;

const targetIndustries = industriesData.targetIndustries as Industry[];
---

<BaseLayout title={title} description={description}>
  <main class="min-h-screen bg-[var(--ezd-bg)] text-[var(--ezd-text)]">
    <ProductHero
      eyebrow={pageContent.hero.eyebrow}
      title={pageContent.hero.title}
      description={pageContent.hero.description}
      primaryCTA={pageContent.hero.primaryCTA}
      secondaryCTA={pageContent.hero.secondaryCTA}
      previewMessages={heroPreviewMessages}
      previewNote={pageContent.hero.previewNote}
    />

    <PainPointGrid
      eyebrow={pageContent.painPoints.eyebrow}
      title={pageContent.painPoints.title}
      description={pageContent.painPoints.description}
      items={pageContent.painPoints.items}
    />

    <FeatureGrid
      eyebrow={pageContent.difference.eyebrow}
      title={pageContent.difference.title}
      description={pageContent.difference.description}
      features={pageContent.difference.features}
      background="soft"
    />

    <section id="live-demo" class="py-20">
      <div class="ezd-container">
        <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
          <div>
            <p class="ezd-eyebrow">
              {pageContent.liveDemo.eyebrow}
            </p>

            <h2 class="ezd-heading-section mt-4 text-3xl md:text-5xl">
              {pageContent.liveDemo.title}
            </h2>

            <p class="ezd-body-large mt-5 text-[var(--ezd-text-muted)]">
              {pageContent.liveDemo.description}
            </p>

            <p class="ezd-body-small mt-5 rounded-[var(--ezd-radius-lg)] border border-[var(--ezd-border)] bg-[var(--ezd-bg-soft)] p-4 text-[var(--ezd-text-muted)]">
              AI có thể hỗ trợ tư vấn ban đầu và có thể chưa chính xác trong mọi trường hợp.
              EZDesign không lưu nội dung hội thoại cá nhân và không dùng chat để thu thập thông tin nhạy cảm.
            </p>
          </div>

          <Card padding="lg" class="min-h-[420px] border-dashed">
            <div
              id="ezd-ai-chat-demo"
              class="min-h-[360px] rounded-[var(--ezd-radius-xl)] bg-[var(--ezd-bg-soft)] p-6"
            >
              <p class="text-sm font-black uppercase tracking-[0.22em] text-[var(--ezd-brand)]">
                {pageContent.liveDemo.placeholderTitle}
              </p>

              <p class="ezd-body-small mt-4 text-[var(--ezd-text-muted)]">
                {pageContent.liveDemo.placeholderDescription}
              </p>
            </div>
          </Card>
        </div>
      </div>
    </section>

    <UseCaseGrid
      eyebrow={pageContent.useCases.eyebrow}
      title={pageContent.useCases.title}
      description={pageContent.useCases.description}
      items={targetIndustries}
    />

    <FeatureSpotlight
      eyebrow={pageContent.spotlight.eyebrow}
      title={pageContent.spotlight.title}
      description={pageContent.spotlight.description}
      features={pageContent.spotlight.features}
    />

    <PricingGrid
      eyebrow={pageContent.pricing.eyebrow}
      title={pageContent.pricing.title}
      description={pageContent.pricing.description}
      plans={ezdAiChatPlans}
      note={pricingNote}
    />

    <FAQGrid
      eyebrow={pageContent.faq.eyebrow}
      title={pageContent.faq.title}
      description={pageContent.faq.description}
      faqs={pageContent.faq.items}
    />

    <CTASection
      eyebrow={pageContent.finalCTA.eyebrow}
      title={pageContent.finalCTA.title}
      description={pageContent.finalCTA.description}
      primaryCTA={pageContent.finalCTA.primaryCTA}
      secondaryCTA={pageContent.finalCTA.secondaryCTA}
    />
  </main>
</BaseLayout>