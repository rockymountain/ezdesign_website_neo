---
import BaseLayout from '../layouts/BaseLayout.astro';
import pricingData from '../data/pricing.json';
import industriesData from '../data/industries.json';
import ProductHero from '../components/sections/ProductHero.astro';
import PainPointGrid from '../components/sections/PainPointGrid.astro';
import FeatureGrid from '../components/sections/FeatureGrid.astro';
import UseCaseGrid from '../components/sections/UseCaseGrid.astro';

const title = 'EZD AI Chat — AI Brand Assistant cho SME B2C | EZDesign';
const description =
  'EZD AI Chat giúp SME B2C có một nhân vật AI mang giọng thương hiệu, biết tư vấn khách, trả lời FAQ, thu lead và chuyển khách sang người thật khi cần.';

const { ezdAiChatPricing, pricingNote } = pricingData;
const { targetIndustries } = industriesData;

const painPoints = [
  {
    title: 'Khách hỏi lặp lại',
    description: 'Khách hỏi nhiều câu giống nhau nhưng nhân sự không phải lúc nào cũng phản hồi kịp.',
  },
  {
    title: 'Traffic chưa thành lead',
    description: 'Website có lượt truy cập nhưng thiếu một điểm chạm đủ nhanh để dẫn khách tới hành động.',
  },
  {
    title: 'Chatbot quá máy móc',
    description: 'Các chatbot truyền thống thường khô cứng, không phản ánh được cá tính thương hiệu.',
  },
  {
    title: 'Khách cần tư vấn trước khi mua',
    description: 'Nhiều ngành B2C cần giải thích, tư vấn, gợi ý hoặc đặt lịch trước khi chuyển đổi.',
  },
  {
    title: 'Đội ngũ nhỏ thiếu người trực',
    description: 'SME khó duy trì phản hồi nhanh trên mọi khung giờ nếu chỉ dựa vào nhân sự thật.',
  },
];

const differences = [
  {
    title: 'Có nhân vật AI đại diện thương hiệu',
    description:
      'EZD AI Chat không chỉ là khung chat. Mỗi doanh nghiệp có thể có một AI Brand Character với tên, vai trò, giọng nói và cách xưng hô riêng.',
  },
  {
    title: 'Biết tư vấn và dẫn khách tới hành động',
    description:
      'AI có thể gợi ý thông tin phù hợp, dẫn khách qua quick replies, form lead hoặc chuyển sang kênh người thật khi cần.',
  },
  {
    title: 'Dễ triển khai theo mô hình managed SaaS',
    description:
      'Team EZDesign setup, tinh chỉnh và tối ưu định kỳ, phù hợp với SME không có đội kỹ thuật nội bộ.',
  },
];

const coreFeatures = [
  {
    title: 'AI Brand Character',
    description: 'Tùy chỉnh tên, vai trò, giọng nói, cách xưng hô và tính cách của nhân vật AI.',
  },
  {
    title: 'FAQ Guardrail',
    description: 'Ưu tiên trả lời chính xác các thông tin quan trọng như địa chỉ, giờ mở cửa, giá cơ bản và chính sách.',
  },
  {
    title: 'Quick Replies',
    description: 'Gợi ý lựa chọn nhanh để khách dễ bắt đầu hội thoại và đi đúng luồng chuyển đổi.',
  },
  {
    title: 'Lead Flow',
    description: 'Thu thông tin khách hàng theo ngữ cảnh như nhu cầu, thời gian, kênh liên hệ hoặc website hiện tại.',
  },
  {
    title: 'Human Handoff',
    description: 'Chuyển khách sang Zalo, Messenger, WhatsApp hoặc hotline khi cần người thật hỗ trợ.',
  },
  {
    title: 'Basic Analytics',
    description: 'Theo dõi lượt mở chat, quick reply clicks, lead flow starts/completions và handoff clicks.',
  },
];

const faqs = [
  {
    question: 'EZD AI Chat có phải chatbot thông thường không?',
    answer:
      'Không. EZD AI Chat được thiết kế như một AI brand assistant có nhân vật, giọng thương hiệu, FAQ guardrail, lead flow và handoff sang người thật.',
  },
  {
    question: 'EZDesign có setup giúp không?',
    answer:
      'Có. Giai đoạn đầu EZD AI Chat vận hành theo mô hình managed SaaS: team EZDesign setup và tối ưu định kỳ cho từng khách hàng.',
  },
  {
    question: 'Có lưu nội dung chat không?',
    answer:
      'Không. Theo định hướng hiện tại, EZDesign không lưu nội dung hội thoại cá nhân trong demo AI Chat.',
  },
  {
    question: 'Setup fee tính như thế nào?',
    answer:
      'Setup fee sẽ được báo theo nhu cầu, tùy mức độ custom nhân vật, knowledge base, lead flow, handoff và integration.',
  },
];
---
<BaseLayout title={title} description={description}>
  <main class="min-h-screen bg-[var(--ezd-bg)] text-[var(--ezd-text)]">
    <!-- Hero -->
    <ProductHero
      eyebrow="EZD AI Chat"
      title="Biến website thành nhân viên tư vấn 24/7 với AI Brand Assistant."
      description="EZD AI Chat giúp website của bạn có một nhân vật AI mang giọng thương hiệu, biết trả lời FAQ, tư vấn khách, dẫn dắt lead flow và chuyển khách sang người thật khi cần."
      primaryCTA={{
        label: 'Đặt lịch demo',
        href: '/contact/',
      }}
      secondaryCTA={{
        label: 'Xem AI demo',
        href: '#live-demo',
      }}
      previewNote="Production widget sẽ được tích hợp tại vùng preview này sau khi hoàn tất UI website."
    />

    <!-- Pain Points -->
    <PainPointGrid
      eyebrow="Vấn đề"
      title="Website có traffic, nhưng bạn đang đánh rơi khách hàng mỗi ngày?"
      description="Một điểm chạm biết trò chuyện giúp bạn phản hồi nhanh hơn, tư vấn đúng ngữ cảnh hơn và dẫn khách tới hành động rõ ràng hơn."
      items={painPoints}
    />

    <!-- Difference -->
    <FeatureGrid
      eyebrow="Khác biệt"
      title="Không chỉ là chatbot. Đây là một AI brand assistant."
      description="EZD AI Chat được thiết kế như một nhân vật đại diện thương hiệu, có vai trò, giọng nói và hành trình hội thoại riêng."
      features={differences}
      background="soft"
    />

    <!-- Live Demo -->
    <section id="live-demo" class="py-20">
      <div class="ezd-container">
        <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.25em] text-[var(--ezd-brand)]">
              Live Demo
            </p>

            <h2 class="mt-4 text-3xl font-bold tracking-tight md:text-5xl">
              Trải nghiệm EZD Assistant ngay trên website.
            </h2>

            <p class="mt-5 text-lg leading-8 text-[var(--ezd-text-muted)]">
              Vùng này sẽ embed AI thật của EZD Assistant. Nội dung chat không được lưu
              và AI chỉ hỗ trợ tư vấn ban đầu.
            </p>

            <p class="mt-5 rounded-[var(--ezd-radius-lg)] border border-[var(--ezd-border)] bg-[var(--ezd-bg-soft)] p-4 text-sm leading-6 text-[var(--ezd-text-muted)]">
              AI có thể hỗ trợ tư vấn ban đầu và có thể chưa chính xác trong mọi trường hợp.
              EZDesign không lưu nội dung hội thoại cá nhân và không dùng chat để thu thập thông tin nhạy cảm.
            </p>
          </div>

          <div class="rounded-[var(--ezd-radius-2xl)] border border-dashed border-[var(--ezd-border-strong)] bg-[var(--ezd-bg-soft)] p-6">
            <div id="ezd-ai-chat-demo" class="min-h-[420px] rounded-[var(--ezd-radius-xl)] bg-white p-6 shadow-[var(--ezd-shadow-sm)]">
              <p class="text-sm font-semibold text-[var(--ezd-brand)]">EZD Assistant widget embed placeholder</p>
              <p class="mt-3 text-sm leading-6 text-[var(--ezd-text-muted)]">
                Sprint sau sẽ gắn script/widget thật tại đây.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Use Cases -->
    <UseCaseGrid
      eyebrow="Use Cases"
      title="Phù hợp với các ngành cần tư vấn trước khi chuyển đổi."
      description="EZD AI Chat phù hợp với các SME B2C có khách hàng cần hỏi, so sánh, đặt lịch hoặc để lại thông tin trước khi mua."
      items={targetIndustries}
    />

    <!-- Core Features -->
    <section class="py-20">
      <div class="ezd-container">
        <div class="max-w-2xl">
          <p class="text-sm font-semibold uppercase tracking-[0.25em] text-[var(--ezd-brand)]">
            Features
          </p>

          <h2 class="mt-4 text-3xl font-bold tracking-tight md:text-5xl">
            Một lớp AI nhẹ, dễ triển khai và có khả năng dẫn dắt chuyển đổi.
          </h2>
        </div>

        <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {
            coreFeatures.map((feature) => (
              <div class="rounded-[var(--ezd-radius-xl)] border border-[var(--ezd-border)] bg-white p-6 shadow-[var(--ezd-shadow-sm)]">
                <h3 class="text-xl font-semibold">{feature.title}</h3>
                <p class="mt-3 text-sm leading-6 text-[var(--ezd-text-muted)]">
                  {feature.description}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Pricing -->
    <section class="bg-[var(--ezd-bg-soft)] py-20">
      <div class="ezd-container">
        <div class="max-w-2xl">
          <p class="text-sm font-semibold uppercase tracking-[0.25em] text-[var(--ezd-brand)]">
            Pricing
          </p>

          <h2 class="mt-4 text-3xl font-bold tracking-tight md:text-5xl">
            Gói triển khai linh hoạt cho SME.
          </h2>

          <p class="mt-5 text-lg leading-8 text-[var(--ezd-text-muted)]">
            EZD AI Chat vận hành theo mô hình managed SaaS, phù hợp với doanh nghiệp nhỏ
            muốn có AI tư vấn mà không cần tự xây hệ thống.
          </p>
        </div>

        <div class="mt-10 grid gap-5 lg:grid-cols-3">
          {
            ezdAiChatPricing.map((plan) => (
              <div class="rounded-[var(--ezd-radius-2xl)] border border-[var(--ezd-border)] bg-white p-6 shadow-[var(--ezd-shadow-sm)]">
                <h3 class="text-2xl font-bold">{plan.name}</h3>
                <p class="mt-3 text-3xl font-bold text-[var(--ezd-brand)]">{plan.priceLabel}</p>
                <p class="mt-4 text-sm leading-6 text-[var(--ezd-text-muted)]">
                  {plan.description}
                </p>

                <ul class="mt-6 space-y-3">
                  {
                    plan.features.map((feature) => (
                      <li class="text-sm leading-6 text-[var(--ezd-text-muted)]">
                        <span class="font-semibold text-[var(--ezd-brand)]">✓</span> {feature}
                      </li>
                    ))
                  }
                </ul>
              </div>
            ))
          }
        </div>

        <p class="mt-6 text-sm leading-6 text-[var(--ezd-text-muted)]">{pricingNote}</p>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-20">
      <div class="ezd-container">
        <div class="max-w-2xl">
          <p class="text-sm font-semibold uppercase tracking-[0.25em] text-[var(--ezd-brand)]">
            FAQ
          </p>

          <h2 class="mt-4 text-3xl font-bold tracking-tight md:text-5xl">
            Những câu hỏi thường gặp.
          </h2>
        </div>

        <div class="mt-10 space-y-4">
          {
            faqs.map((faq) => (
              <div class="rounded-[var(--ezd-radius-xl)] border border-[var(--ezd-border)] bg-white p-6 shadow-[var(--ezd-shadow-sm)]">
                <h3 class="text-lg font-semibold">{faq.question}</h3>
                <p class="mt-3 text-sm leading-6 text-[var(--ezd-text-muted)]">{faq.answer}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="pb-20">
      <div class="ezd-container">
        <div class="rounded-[var(--ezd-radius-2xl)] bg-[var(--ezd-text)] p-8 text-white md:p-12">
          <h2 class="max-w-3xl text-3xl font-bold tracking-tight md:text-5xl">
            Muốn có một nhân vật AI tư vấn cho website của bạn?
          </h2>

          <p class="mt-5 max-w-2xl text-lg leading-8 text-white/75">
            Đặt lịch demo để xem EZD AI Chat có thể phù hợp với ngành, website và hành trình khách hàng của bạn như thế nào.
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href="/contact/"
              class="ezd-focus-ring inline-flex rounded-full bg-white px-5 py-3 text-sm font-semibold text-[var(--ezd-text)] hover:bg-white/90"
            >
              Đặt lịch demo
            </a>

            <a
              href="/case-studies/yen-ai-chat/"
              class="ezd-focus-ring inline-flex rounded-full border border-white/20 px-5 py-3 text-sm font-semibold text-white hover:bg-white/10"
            >
              Xem case Yên AI Chat
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>