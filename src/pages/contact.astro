---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/common/SectionHeader.astro';
import CTASection from '../components/common/CTASection.astro';
import Card from '../components/common/Card.astro';

import pageContent from '../data/contact.json';

type CTA = {
  label: string;
  href: string;
};

type ContactChannel = {
  label: string;
  value: string;
  href: string;
  description: string;
};

type NextStep = {
  step: string;
  title: string;
  description: string;
};

type DemoExpectation = {
  title: string;
  description: string;
};

const title = pageContent.seo.title;
const description = pageContent.seo.description;

const interestOptions = pageContent.interestOptions as string[];
const industries = pageContent.industries as string[];
const contactChannels = pageContent.contactChannels as ContactChannel[];
const nextSteps = pageContent.nextSteps as NextStep[];
const demoExpectations = pageContent.demoExpectations.items as DemoExpectation[];

const finalPrimaryCTA = pageContent.finalCTA.primaryCTA as CTA;
const finalSecondaryCTA = pageContent.finalCTA.secondaryCTA as CTA;

const turnstileSiteKey =
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '1x00000000000000000000AA';

const fieldClass =
  'ezd-focus-ring w-full min-w-0 rounded-[var(--ezd-radius-lg)] border border-[var(--ezd-border)] bg-white px-4 py-3 text-sm outline-none transition focus:border-[var(--ezd-brand)]';

const labelClass = 'grid min-w-0 gap-2';
---

<BaseLayout title={title} description={description}>
  <main class="min-h-screen bg-[var(--ezd-bg)] text-[var(--ezd-text)]">
    <!-- Hero -->
    <section class="relative overflow-hidden border-b border-[var(--ezd-border)] bg-[var(--ezd-bg-soft)] py-20">
      <div
        class="pointer-events-none absolute -right-24 top-10 h-72 w-72 rounded-full bg-[var(--ezd-accent)] opacity-20 blur-3xl"
        aria-hidden="true"
      >
      </div>

      <div
        class="pointer-events-none absolute -left-24 bottom-0 h-72 w-72 rounded-full bg-[var(--ezd-brand)] opacity-10 blur-3xl"
        aria-hidden="true"
      >
      </div>

      <div class="ezd-container relative">
        <SectionHeader
          eyebrow={pageContent.hero.eyebrow}
          title={pageContent.hero.title}
          description={pageContent.hero.description}
          headingLevel="h1"
          maxWidth="xl"
        />
      </div>
    </section>

    <!-- Contact Form + Channels -->
    <section class="py-20">
      <div class="ezd-container">
        <div class="grid gap-10 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] lg:items-start">
          <Card padding="lg" class="min-w-0">
            <div class="max-w-2xl">
              <p class="ezd-eyebrow">
                {pageContent.form.eyebrow}
              </p>

              <h2 class="ezd-heading-section mt-4 text-3xl md:text-5xl">
                {pageContent.form.title}
              </h2>

              <p class="ezd-body-large mt-5 text-[var(--ezd-text-muted)]">
                {pageContent.form.description}
              </p>
            </div>

            <form class="mt-10 grid min-w-0 gap-5" data-contact-form novalidate>
              <!-- Honeypot: bots may fill this, humans should never see it -->
              <label class="hidden" aria-hidden="true">
                Leave this field empty
                <input
                  type="text"
                  name="company"
                  tabindex="-1"
                  autocomplete="off"
                  data-contact-honeypot
                />
              </label>

              <div class="grid min-w-0 gap-5 md:grid-cols-2">
                <label for="contact-name" class={labelClass}>
                  <span class="text-sm font-black text-[var(--ezd-text)]">
                    Tên của bạn
                  </span>

                  <input
                    id="contact-name"
                    type="text"
                    name="name"
                    required
                    autocomplete="name"
                    placeholder="Ví dụ: Nguyễn An"
                    class={fieldClass}
                    data-contact-field
                  />

                  <p class="hidden text-xs font-semibold text-red-600" data-field-error="name">
                    Vui lòng nhập tên của bạn.
                  </p>
                </label>

                <label for="contact-info" class={labelClass}>
                  <span class="text-sm font-black text-[var(--ezd-text)]">
                    Email / Số điện thoại
                  </span>

                  <input
                    id="contact-info"
                    type="text"
                    name="contact"
                    required
                    autocomplete="email"
                    placeholder="email@domain.com hoặc số điện thoại"
                    class={fieldClass}
                    data-contact-field
                  />

                  <p class="hidden text-xs font-semibold text-red-600" data-field-error="contact">
                    Vui lòng nhập email hoặc số điện thoại để EZDesign phản hồi.
                  </p>
                </label>
              </div>

              <div class="grid min-w-0 gap-5 md:grid-cols-2">
                <label for="contact-interest" class={labelClass}>
                  <span class="text-sm font-black text-[var(--ezd-text)]">
                    Bạn quan tâm giải pháp nào?
                  </span>

                  <select
                    id="contact-interest"
                    name="interest"
                    required
                    class={fieldClass}
                    data-contact-field
                  >
                    <option value="">Chọn giải pháp</option>
                    {
                      interestOptions.map((option: string) => (
                        <option value={option}>{option}</option>
                      ))
                    }
                  </select>

                  <p class="hidden text-xs font-semibold text-red-600" data-field-error="interest">
                    Vui lòng chọn giải pháp bạn quan tâm.
                  </p>
                </label>

                <label for="contact-industry" class={labelClass}>
                  <span class="text-sm font-black text-[var(--ezd-text)]">
                    Ngành / mô hình kinh doanh
                  </span>

                  <select
                    id="contact-industry"
                    name="industry"
                    class={fieldClass}
                    data-contact-field
                  >
                    <option value="">Chọn ngành</option>
                    {
                      industries.map((industry: string) => (
                        <option value={industry}>{industry}</option>
                      ))
                    }
                  </select>
                </label>
              </div>

              <label for="contact-website" class={labelClass}>
                <span class="text-sm font-black text-[var(--ezd-text)]">
                  Website hiện tại
                </span>

                <input
                  id="contact-website"
                  type="url"
                  name="website"
                  autocomplete="url"
                  placeholder="https://..."
                  class={fieldClass}
                  data-contact-field
                />

                <p class="hidden text-xs font-semibold text-red-600" data-field-error="website">
                  Website nên bắt đầu bằng https:// hoặc http://
                </p>
              </label>

              <label for="contact-message" class={labelClass}>
                <span class="text-sm font-black text-[var(--ezd-text)]">
                  Nhu cầu / ghi chú
                </span>

                <textarea
                  id="contact-message"
                  name="message"
                  rows="6"
                  required
                  placeholder="Bạn muốn tư vấn EZD AI Chat, nâng cấp website, tạo trải nghiệm tương tác hay cần demo theo ngành?"
                  class={`${fieldClass} resize-y`}
                  data-contact-field
                ></textarea>

                <p class="hidden text-xs font-semibold text-red-600" data-field-error="message">
                  Vui lòng mô tả ngắn nhu cầu của bạn.
                </p>
              </label>

              <!-- Cloudflare Turnstile -->
              <div class="grid gap-2">
                <p class="text-sm font-black text-[var(--ezd-text)]">
                  Xác minh chống spam
                </p>

                <div
                  class="rounded-[var(--ezd-radius-lg)] border border-[var(--ezd-border)] bg-[var(--ezd-bg-soft)] p-4"
                >
                  <div
                    class="cf-turnstile"
                    data-sitekey={turnstileSiteKey}
                    data-theme="light"
                    data-size="normal"
                    data-callback="onEZDTurnstileSuccess"
                    data-expired-callback="onEZDTurnstileExpired"
                    data-error-callback="onEZDTurnstileError"
                  >
                  </div>
                </div>

                <p
                  class="hidden text-xs font-semibold text-red-600"
                  data-field-error="turnstile"
                >
                  Vui lòng hoàn tất xác minh chống spam trước khi gửi.
                </p>

                <p class="text-xs leading-5 text-[var(--ezd-text-soft)]">
                  EZDesign dùng Cloudflare Turnstile để giảm spam mà không cần câu đố CAPTCHA truyền thống.
                </p>
              </div>

              <div class="grid min-w-0 gap-4">
                <button
                  type="submit"
                  class="ezd-focus-ring inline-flex w-full items-center justify-center rounded-full bg-[var(--ezd-brand)] px-6 py-4 text-sm font-black text-white shadow-[var(--ezd-shadow-sm)] transition hover:bg-[var(--ezd-brand-dark)] hover:shadow-[var(--ezd-shadow-md)] disabled:cursor-not-allowed disabled:opacity-60"
                  data-contact-submit
                >
                  <span data-submit-label>
                    {pageContent.form.submitLabel}
                  </span>

                  <span class="hidden items-center gap-2" data-submit-loading>
                    <span class="ezd-spinner" aria-hidden="true"></span>
                    Đang gửi...
                  </span>
                </button>

                <p class="ezd-body-small mx-auto max-w-xl text-center text-[var(--ezd-text-soft)]">
                  {pageContent.form.privacyNote}
                </p>

                <div
                  class="hidden rounded-[var(--ezd-radius-lg)] border border-[var(--ezd-border)] bg-[var(--ezd-bg-soft)] p-4 text-sm font-semibold text-[var(--ezd-text-muted)]"
                  role="status"
                  aria-live="polite"
                  data-contact-status
                >
                </div>
              </div>
            </form>
          </Card>

          <div class="grid min-w-0 gap-5">
            {
              contactChannels.map((channel: ContactChannel) => (
                <a href={channel.href} class="block">
                  <Card hover>
                    <p class="text-xs font-black uppercase tracking-[0.22em] text-[var(--ezd-brand)]">
                      {channel.label}
                    </p>

                    <h3 class="ezd-heading-card mt-3 text-xl">
                      {channel.value}
                    </h3>

                    <p class="ezd-body-small mt-3 text-[var(--ezd-text-muted)]">
                      {channel.description}
                    </p>

                    <p class="mt-5 text-sm font-black text-[var(--ezd-brand)]">
                      Liên hệ qua kênh này →
                    </p>
                  </Card>
                </a>
              ))
            }

            <Card variant="dark" padding="lg">
              <p class="text-xs font-black uppercase tracking-[0.22em] text-white/70">
                Implementation
              </p>

              <h3 class="ezd-heading-card mt-4 text-2xl text-white">
                Form đã có data contract và Turnstile token.
              </h3>

              <p class="ezd-body-small mt-4 text-white/70">
                Task tiếp theo sẽ kết nối Cloudflare Worker, validate Turnstile qua Siteverify,
                append lead vào Google Sheets và gửi email notification cho team EZDesign.
              </p>
            </Card>
          </div>
        </div>
      </div>
    </section>

    <!-- Next Steps -->
    <section class="bg-[var(--ezd-bg-soft)] py-20">
      <div class="ezd-container">
        <SectionHeader
          eyebrow="Process"
          title="Sau khi bạn gửi yêu cầu, điều gì sẽ diễn ra?"
          description="Quy trình được giữ ngắn gọn để SME có thể nhanh chóng xác định hướng triển khai phù hợp."
          maxWidth="lg"
        />

        <div class="mt-10 grid gap-5 md:grid-cols-3">
          {
            nextSteps.map((item: NextStep) => (
              <Card hover padding="lg">
                <p class="text-xs font-black uppercase tracking-[0.22em] text-[var(--ezd-brand)]">
                  {item.step}
                </p>

                <h3 class="ezd-heading-card mt-4 text-2xl">
                  {item.title}
                </h3>

                <p class="ezd-body-small mt-4 text-[var(--ezd-text-muted)]">
                  {item.description}
                </p>
              </Card>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Demo Expectations -->
    <section class="py-20">
      <div class="ezd-container">
        <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
          <SectionHeader
            eyebrow={pageContent.demoExpectations.eyebrow}
            title={pageContent.demoExpectations.title}
            maxWidth="lg"
          />

          <div class="grid gap-5">
            {
              demoExpectations.map((item: DemoExpectation) => (
                <Card hover>
                  <h3 class="ezd-heading-card text-xl">
                    {item.title}
                  </h3>

                  <p class="ezd-body-small mt-3 text-[var(--ezd-text-muted)]">
                    {item.description}
                  </p>
                </Card>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <CTASection
      eyebrow={pageContent.finalCTA.eyebrow}
      title={pageContent.finalCTA.title}
      description={pageContent.finalCTA.description}
      primaryCTA={finalPrimaryCTA}
      secondaryCTA={finalSecondaryCTA}
    />
  </main>

  <script
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    async
    defer
  ></script>

  <script is:inline>
    window.__ezdTurnstileToken = '';

    window.onEZDTurnstileSuccess = (token) => {
      window.__ezdTurnstileToken = token || '';

      const contactForm = document.querySelector('[data-contact-form]');
      const turnstileError = contactForm?.querySelector('[data-field-error="turnstile"]');

      turnstileError?.classList.add('hidden');
    };

    window.onEZDTurnstileExpired = () => {
      window.__ezdTurnstileToken = '';
    };

    window.onEZDTurnstileError = () => {
      window.__ezdTurnstileToken = '';

      const contactForm = document.querySelector('[data-contact-form]');
      const turnstileError = contactForm?.querySelector('[data-field-error="turnstile"]');

      if (turnstileError) {
        turnstileError.textContent = 'Cloudflare Turnstile đang gặp lỗi. Vui lòng tải lại trang hoặc thử lại sau.';
        turnstileError.classList.remove('hidden');
      }
    };

    const contactForm = document.querySelector('[data-contact-form]');

    if (contactForm) {
      const submitButton = contactForm.querySelector('[data-contact-submit]');
      const submitLabel = contactForm.querySelector('[data-submit-label]');
      const submitLoading = contactForm.querySelector('[data-submit-loading]');
      const statusBox = contactForm.querySelector('[data-contact-status]');

      const fieldErrorMap = {
        name: 'Vui lòng nhập tên của bạn.',
        contact: 'Vui lòng nhập email hoặc số điện thoại để EZDesign phản hồi.',
        interest: 'Vui lòng chọn giải pháp bạn quan tâm.',
        message: 'Vui lòng mô tả ngắn nhu cầu của bạn.',
      };

      const showStatus = (type, message) => {
        if (!statusBox) return;

        statusBox.classList.remove(
          'hidden',
          'border-[var(--ezd-border)]',
          'bg-[var(--ezd-bg-soft)]',
          'text-[var(--ezd-text-muted)]',
          'border-red-200',
          'bg-red-50',
          'text-red-700',
          'border-green-200',
          'bg-green-50',
          'text-green-700',
        );

        if (type === 'success') {
          statusBox.classList.add('border-green-200', 'bg-green-50', 'text-green-700');
        } else if (type === 'error') {
          statusBox.classList.add('border-red-200', 'bg-red-50', 'text-red-700');
        } else {
          statusBox.classList.add(
            'border-[var(--ezd-border)]',
            'bg-[var(--ezd-bg-soft)]',
            'text-[var(--ezd-text-muted)]',
          );
        }

        statusBox.textContent = message;
      };

      const setLoading = (isLoading) => {
        if (!submitButton || !submitLabel || !submitLoading) return;

        submitButton.disabled = isLoading;

        submitLabel.classList.toggle('hidden', isLoading);
        submitLoading.classList.toggle('hidden', !isLoading);
        submitLoading.classList.toggle('inline-flex', isLoading);
      };

      const clearErrors = () => {
        contactForm.querySelectorAll('[data-contact-field]').forEach((field) => {
          field.classList.remove('border-red-500');
        });

        contactForm.querySelectorAll('[data-field-error]').forEach((error) => {
          error.classList.add('hidden');
        });
      };

      const validateForm = () => {
        clearErrors();

        let isValid = true;
        const formData = new FormData(contactForm);

        Object.keys(fieldErrorMap).forEach((fieldName) => {
          const value = String(formData.get(fieldName) || '').trim();

          if (!value) {
            isValid = false;

            const field = contactForm.querySelector(`[name="${fieldName}"]`);
            const error = contactForm.querySelector(`[data-field-error="${fieldName}"]`);

            field?.classList.add('border-red-500');
            error?.classList.remove('hidden');
          }
        });

        const website = String(formData.get('website') || '').trim();

        if (website && !/^https?:\/\/.+/i.test(website)) {
          isValid = false;

          const field = contactForm.querySelector('[name="website"]');
          const error = contactForm.querySelector('[data-field-error="website"]');

          field?.classList.add('border-red-500');
          error?.classList.remove('hidden');
        }

        const turnstileToken =
          window.__ezdTurnstileToken ||
          String(formData.get('cf-turnstile-response') || '').trim();

        if (!turnstileToken) {
          isValid = false;

          const error = contactForm.querySelector('[data-field-error="turnstile"]');

          if (error) {
            error.textContent = 'Vui lòng hoàn tất xác minh chống spam trước khi gửi.';
            error.classList.remove('hidden');
          }
        }

        return isValid;
      };

      const buildPayload = () => {
        const formData = new FormData(contactForm);

        return {
          name: String(formData.get('name') || '').trim(),
          contact: String(formData.get('contact') || '').trim(),
          interest: String(formData.get('interest') || '').trim(),
          industry: String(formData.get('industry') || '').trim(),
          website: String(formData.get('website') || '').trim(),
          message: String(formData.get('message') || '').trim(),
          sourcePath: window.location.pathname,
          submittedAt: new Date().toISOString(),
          userAgent: window.navigator.userAgent,
          honeypot: String(formData.get('company') || '').trim(),
          turnstileToken:
            window.__ezdTurnstileToken ||
            String(formData.get('cf-turnstile-response') || '').trim(),
        };
      };

      contactForm.addEventListener('submit', async (event) => {
        event.preventDefault();

        const isValid = validateForm();

        if (!isValid) {
          showStatus(
            'error',
            'Một vài thông tin chưa hợp lệ. Vui lòng kiểm tra lại các trường được đánh dấu.',
          );
          return;
        }

        const payload = buildPayload();

        console.info('[EZD Contact Payload]', payload);

        setLoading(true);
        showStatus(
          'default',
          'Payload đã được chuẩn hóa. Task tiếp theo sẽ kết nối Cloudflare Worker để validate Turnstile và gửi dữ liệu thật.',
        );

        window.setTimeout(() => {
          setLoading(false);
          showStatus(
            'success',
            'Form data contract đã sẵn sàng. Kiểm tra payload trong DevTools console trước khi nối backend.',
          );
        }, 700);
      });
    }
  </script>
</BaseLayout>