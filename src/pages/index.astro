---
import '../styles/global.css';
---

<main class="min-h-screen bg-[var(--ezd-bg-soft)] py-16">
  <section class="ezd-container">
    <div class="rounded-[var(--ezd-radius-2xl)] border border-[var(--ezd-border)] bg-[var(--ezd-surface)] p-8 shadow-[var(--ezd-shadow-md)]">
      <p class="text-sm font-semibold uppercase tracking-[0.3em] text-[var(--ezd-brand)]">
        EZDesign Website Neo
      </p>

      <h1 class="mt-4 max-w-3xl text-4xl font-bold tracking-tight text-[var(--ezd-text)] md:text-6xl">
        Design tokens are ready.
      </h1>

      <p class="mt-6 max-w-2xl text-lg leading-8 text-[var(--ezd-text-muted)]">
        Nền tảng màu sắc, typography, spacing, border, radius và shadow đã sẵn sàng
        cho UI system của EZDesign Website mới.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/ezd-ai-chat/"
          class="ezd-focus-ring rounded-full bg-[var(--ezd-brand)] px-5 py-3 text-sm font-semibold text-white shadow-[var(--ezd-shadow-sm)] hover:bg-[var(--ezd-brand-dark)]"
        >
          Đặt lịch demo
        </a>

        <a
          href="/contact/"
          class="ezd-focus-ring rounded-full border border-[var(--ezd-border-strong)] bg-white px-5 py-3 text-sm font-semibold text-[var(--ezd-text)] hover:bg-[var(--ezd-surface-muted)]"
        >
          Tư vấn giải pháp
        </a>
      </div>
    </div>
  </section>
</main>