---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

type InsightEntry = CollectionEntry<'insights'>;

const allInsights: InsightEntry[] = await getCollection('insights');

const insights = allInsights
  .filter((insight: InsightEntry) => !insight.data.isDraft)
  .sort(
    (a: InsightEntry, b: InsightEntry) =>
      b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
  );

const draftInsights = allInsights.filter((insight: InsightEntry) => insight.data.isDraft);

const title = 'Insights — AI Chat, AI Brand Character và trải nghiệm số | EZDesign';
const description =
  'Góc nhìn từ EZDesign về AI Chat, AI Brand Character, lead generation và các điểm chạm số cho SME B2C.';

---
<BaseLayout title={title} description={description}>
  <main class="min-h-screen bg-[var(--ezd-bg)] text-[var(--ezd-text)]">
    <!-- Hero -->
    <section class="border-b border-[var(--ezd-border)] bg-[var(--ezd-bg-soft)] py-20">
      <div class="ezd-container">
        <p class="text-sm font-semibold uppercase tracking-[0.3em] text-[var(--ezd-brand)]">
          Insights
        </p>

        <h1 class="mt-5 max-w-4xl text-4xl font-bold tracking-tight md:text-6xl">
          Góc nhìn về AI Chat, AI Brand Character và trải nghiệm số cho SME.
        </h1>

        <p class="mt-6 max-w-2xl text-lg leading-8 text-[var(--ezd-text-muted)]">
          Khu vực này được chuẩn bị sẵn cho các bài viết SEO và nội dung chuyên sâu.
          Trong Sprint 1, Insights chưa được đưa vào navigation chính.
        </p>
      </div>
    </section>

    <!-- Published Insights -->
    <section class="py-20">
      <div class="ezd-container">
        <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.25em] text-[var(--ezd-brand)]">
              Published
            </p>

            <h2 class="mt-4 text-3xl font-bold tracking-tight md:text-5xl">
              Bài viết đã publish.
            </h2>
          </div>

          <p class="text-sm text-[var(--ezd-text-muted)]">
            {insights.length} bài viết
          </p>
        </div>

        {
          insights.length > 0 ? (
            <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
              {insights.map((insight: InsightEntry) => (
                <a
                  href={`/insights/${insight.data.slug}/`}
                  class="rounded-[var(--ezd-radius-xl)] border border-[var(--ezd-border)] bg-white p-6 shadow-[var(--ezd-shadow-sm)] transition hover:-translate-y-1 hover:shadow-[var(--ezd-shadow-md)]"
                >
                  <p class="text-sm font-semibold text-[var(--ezd-brand)]">
                    {insight.data.category}
                  </p>

                  <h3 class="mt-3 text-xl font-semibold">{insight.data.title}</h3>

                  <p class="mt-3 text-sm leading-6 text-[var(--ezd-text-muted)]">
                    {insight.data.excerpt}
                  </p>

                  <p class="mt-5 text-xs uppercase tracking-[0.2em] text-[var(--ezd-text-soft)]">
                    {insight.data.publishedAt.toLocaleDateString('vi-VN')}
                  </p>
                </a>
              ))}
            </div>
          ) : (
            <div class="mt-10 rounded-[var(--ezd-radius-2xl)] border border-dashed border-[var(--ezd-border-strong)] bg-[var(--ezd-bg-soft)] p-8">
              <h3 class="text-xl font-semibold">Chưa có bài viết public.</h3>
              <p class="mt-3 text-sm leading-6 text-[var(--ezd-text-muted)]">
                Insights route đã được chuẩn bị. Các bài viết sẽ được publish ở sprint content/SEO sau.
              </p>
            </div>
          )
        }
      </div>
    </section>

    <!-- Drafts for internal visibility -->
    {
      draftInsights.length > 0 && (
        <section class="bg-[var(--ezd-bg-soft)] py-20">
          <div class="ezd-container">
            <div class="max-w-2xl">
              <p class="text-sm font-semibold uppercase tracking-[0.25em] text-[var(--ezd-brand)]">
                Drafts
              </p>

              <h2 class="mt-4 text-3xl font-bold tracking-tight md:text-5xl">
                Bài viết đang chuẩn bị.
              </h2>

              <p class="mt-5 text-lg leading-8 text-[var(--ezd-text-muted)]">
                Section này chỉ để xác nhận content collection đã hoạt động trong Sprint 1.
                Khi build production, có thể ẩn draft nếu muốn.
              </p>
            </div>

            <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
              {draftInsights.map((insight: InsightEntry) => (
                <div class="rounded-[var(--ezd-radius-xl)] border border-[var(--ezd-border)] bg-white p-6 shadow-[var(--ezd-shadow-sm)]">
                  <p class="text-sm font-semibold text-[var(--ezd-brand)]">
                    Draft · {insight.data.category}
                  </p>

                  <h3 class="mt-3 text-xl font-semibold">{insight.data.title}</h3>

                  <p class="mt-3 text-sm leading-6 text-[var(--ezd-text-muted)]">
                    {insight.data.excerpt}
                  </p>

                  <p class="mt-5 text-xs uppercase tracking-[0.2em] text-[var(--ezd-text-soft)]">
                    {insight.data.publishedAt.toLocaleDateString('vi-VN')}
                  </p>
                </div>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- Final CTA -->
    <section class="py-20">
      <div class="ezd-container">
        <div class="rounded-[var(--ezd-radius-2xl)] bg-[var(--ezd-text)] p-8 text-white md:p-12">
          <h2 class="max-w-3xl text-3xl font-bold tracking-tight md:text-5xl">
            Muốn trao đổi trực tiếp thay vì đọc thêm?
          </h2>

          <p class="mt-5 max-w-2xl text-lg leading-8 text-white/75">
            Đặt lịch demo để EZDesign tư vấn cách dùng AI Chat và trải nghiệm số cho website của bạn.
          </p>

          <div class="mt-8">
            <a
              href="/contact/"
              class="ezd-focus-ring inline-flex rounded-full bg-white px-5 py-3 text-sm font-semibold text-[var(--ezd-text)] hover:bg-white/90"
            >
              Đặt lịch demo
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>