---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/common/SectionHeader.astro';
import CTASection from '../../components/common/CTASection.astro';
import Card from '../../components/common/Card.astro';
import ButtonLink from '../../components/common/ButtonLink.astro';

import { getCollection } from 'astro:content';
import pageContent from '../../data/insights-page.json';

type InsightEntry = Awaited<ReturnType<typeof getCollection<'insights'>>>[number];

type CTA = {
  label: string;
  href: string;
};

const title = pageContent.seo.title;
const description = pageContent.seo.description;

const allInsights = await getCollection('insights');

const insights = allInsights
  .filter((insight: InsightEntry) => !insight.data.isDraft)
  .sort(
    (a: InsightEntry, b: InsightEntry) =>
      b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
  );

const draftInsights = allInsights
  .filter((insight: InsightEntry) => insight.data.isDraft)
  .sort(
    (a: InsightEntry, b: InsightEntry) =>
      b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
  );

const finalPrimaryCTA = pageContent.finalCTA.primaryCTA as CTA;
---

<BaseLayout title={title} description={description}>
  <main class="min-h-screen bg-[var(--ezd-bg)] text-[var(--ezd-text)]">
    <!-- Hero -->
    <section class="border-b border-[var(--ezd-border)] bg-[var(--ezd-bg-soft)] py-20">
      <div class="ezd-container">
        <SectionHeader
          eyebrow={pageContent.hero.eyebrow}
          title={pageContent.hero.title}
          description={pageContent.hero.description}
          headingLevel="h1"
          maxWidth="xl"
        />
      </div>
    </section>

    <!-- Published Insights -->
    <section class="py-20">
      <div class="ezd-container">
        <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
          <SectionHeader
            eyebrow={pageContent.published.eyebrow}
            title={pageContent.published.title}
            maxWidth="lg"
          />

          <p class="text-sm font-black text-[var(--ezd-text-soft)]">
            {insights.length} bài viết
          </p>
        </div>

        {
          insights.length > 0 ? (
            <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
              {insights.map((insight: InsightEntry) => (
                <a href={`/insights/${insight.data.slug}/`} class="block">
                  <Card hover padding="lg" class="h-full">
                    <p class="text-xs font-black uppercase tracking-[0.22em] text-[var(--ezd-brand)]">
                      {insight.data.category}
                    </p>

                    <h3 class="ezd-heading-card mt-4 text-2xl">
                      {insight.data.title}
                    </h3>

                    <p class="ezd-body-small mt-4 text-[var(--ezd-text-muted)]">
                      {insight.data.excerpt}
                    </p>

                    <div class="mt-6 flex flex-wrap gap-2">
                      {insight.data.tags.map((tag: string) => (
                        <span class="rounded-full bg-[var(--ezd-brand-soft)] px-3 py-1 text-xs font-black text-[var(--ezd-brand)]">
                          {tag}
                        </span>
                      ))}
                    </div>

                    <p class="mt-6 text-xs font-black uppercase tracking-[0.18em] text-[var(--ezd-text-soft)]">
                      {insight.data.publishedAt.toLocaleDateString('vi-VN')}
                    </p>
                  </Card>
                </a>
              ))}
            </div>
          ) : (
            <Card class="mt-10 border-dashed bg-[var(--ezd-bg-soft)]" padding="lg">
              <h3 class="ezd-heading-card text-2xl">
                {pageContent.published.emptyTitle}
              </h3>

              <p class="ezd-body-small mt-4 text-[var(--ezd-text-muted)]">
                {pageContent.published.emptyDescription}
              </p>

              <div class="mt-6">
                <ButtonLink
                  href="/contact/"
                  label="Đặt lịch demo thay vì đọc thêm"
                  variant="primary"
                  size="md"
                />
              </div>
            </Card>
          )
        }
      </div>
    </section>

    <!-- Draft Insights -->
    {
      draftInsights.length > 0 && (
        <section class="bg-[var(--ezd-bg-soft)] py-20">
          <div class="ezd-container">
            <SectionHeader
              eyebrow={pageContent.drafts.eyebrow}
              title={pageContent.drafts.title}
              description={pageContent.drafts.description}
              maxWidth="lg"
            />

            <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
              {draftInsights.map((insight: InsightEntry) => (
                <a href={`/insights/${insight.data.slug}/`} class="block">
                  <Card hover padding="lg" class="h-full">
                    <p class="text-xs font-black uppercase tracking-[0.22em] text-[var(--ezd-brand)]">
                      Draft · {insight.data.category}
                    </p>

                    <h3 class="ezd-heading-card mt-4 text-2xl">
                      {insight.data.title}
                    </h3>

                    <p class="ezd-body-small mt-4 text-[var(--ezd-text-muted)]">
                      {insight.data.excerpt}
                    </p>

                    <div class="mt-6 flex flex-wrap gap-2">
                      {insight.data.tags.map((tag: string) => (
                        <span class="rounded-full bg-white px-3 py-1 text-xs font-black text-[var(--ezd-text-muted)] shadow-[var(--ezd-shadow-sm)]">
                          {tag}
                        </span>
                      ))}
                    </div>

                    <p class="mt-6 text-xs font-black uppercase tracking-[0.18em] text-[var(--ezd-text-soft)]">
                      {insight.data.publishedAt.toLocaleDateString('vi-VN')}
                    </p>
                  </Card>
                </a>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- Final CTA -->
    <CTASection
      eyebrow={pageContent.finalCTA.eyebrow}
      title={pageContent.finalCTA.title}
      description={pageContent.finalCTA.description}
      primaryCTA={finalPrimaryCTA}
    />
  </main>
</BaseLayout>