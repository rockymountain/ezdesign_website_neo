---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { buildArticleSchema, buildBreadcrumbSchema } from '../../utils/schema';

type InsightEntry = CollectionEntry<'insights'>;

export async function getStaticPaths() {
  const insights: InsightEntry[] = await getCollection('insights');

  return insights.map((insight: InsightEntry) => ({
    params: {
      slug: insight.data.slug,
    },
    props: {
      insight,
    },
  }));
}

type Props = {
  insight: InsightEntry;
};

const { insight } = Astro.props as Props;
const { Content } = await render(insight);

const {
  title,
  excerpt,
  category,
  tags,
  publishedAt,
  updatedAt,
  isDraft,
} = insight.data;

const pageTitle = insight.data.seoTitle;
const pageDescription = insight.data.seoDescription;
const pageOgImage = insight.data.ogImage;

const pageUrl = `/insights/${insight.data.slug}/`;

const jsonLd = [
  buildArticleSchema({
    headline: title,
    description: excerpt,
    url: pageUrl,
    image: pageOgImage,
    datePublished: publishedAt.toISOString(),
    dateModified: updatedAt?.toISOString(),
  }),
  buildBreadcrumbSchema([
    {
      name: 'Home',
      url: '/',
    },
    {
      name: 'Insights',
      url: '/insights/',
    },
    {
      name: title,
      url: pageUrl,
    },
  ]),
];

---
<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage={pageOgImage}
  ogType="article"
  noindex={isDraft}
  publishedTime={publishedAt.toISOString()}
  modifiedTime={updatedAt?.toISOString()}
  jsonLd={jsonLd}
>
  <main class="min-h-screen bg-[var(--ezd-bg)] text-[var(--ezd-text)]">
    <!-- Hero -->
    <section class="border-b border-[var(--ezd-border)] bg-[var(--ezd-bg-soft)] py-20">
      <div class="ezd-container">
        <div class="max-w-4xl">
          <p class="text-sm font-semibold uppercase tracking-[0.3em] text-[var(--ezd-brand)]">
            {isDraft ? 'Draft Insight' : 'Insight'} · {category}
          </p>

          <h1 class="mt-5 text-4xl font-bold tracking-tight md:text-6xl">
            {title}
          </h1>

          <p class="mt-6 max-w-2xl text-lg leading-8 text-[var(--ezd-text-muted)]">
            {excerpt}
          </p>

          <div class="mt-6 flex flex-wrap gap-3 text-sm text-[var(--ezd-text-muted)]">
            <span>
              Published: {publishedAt.toLocaleDateString('vi-VN')}
            </span>

            {
              updatedAt && (
                <span>
                  Updated: {updatedAt.toLocaleDateString('vi-VN')}
                </span>
              )
            }
          </div>

          {
            tags.length > 0 && (
              <div class="mt-6 flex flex-wrap gap-2">
                {tags.map((tag: string) => (
                  <span class="rounded-full border border-[var(--ezd-border)] bg-white px-3 py-1 text-xs font-semibold text-[var(--ezd-text-muted)]">
                    {tag}
                  </span>
                ))}
              </div>
            )
          }
        </div>
      </div>
    </section>

    <!-- Draft notice -->
    {
      isDraft && (
        <section class="py-8">
          <div class="ezd-container">
            <div class="rounded-[var(--ezd-radius-xl)] border border-dashed border-[var(--ezd-border-strong)] bg-[var(--ezd-bg-soft)] p-5 text-sm leading-6 text-[var(--ezd-text-muted)]">
              Bài viết này đang ở trạng thái draft. Route được tạo để kiểm tra content collection và layout,
              chưa nên đưa vào navigation chính hoặc internal link public.
            </div>
          </div>
        </section>
      )
    }

    <!-- Content -->
    <section class="py-20">
      <div class="ezd-container">
        <article class="mx-auto max-w-3xl rounded-[var(--ezd-radius-2xl)] border border-[var(--ezd-border)] bg-white p-6 leading-8 text-[var(--ezd-text-muted)] shadow-[var(--ezd-shadow-sm)] md:p-10">
          <Content />
        </article>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="pb-20">
      <div class="ezd-container">
        <div class="mx-auto max-w-3xl rounded-[var(--ezd-radius-2xl)] bg-[var(--ezd-text)] p-8 text-white md:p-10">
          <h2 class="text-3xl font-bold tracking-tight">
            Muốn áp dụng nội dung này cho website của bạn?
          </h2>

          <p class="mt-5 text-lg leading-8 text-white/75">
            EZDesign có thể tư vấn cách triển khai AI Chat, AI Brand Character hoặc website tương tác phù hợp với ngành của bạn.
          </p>

          <div class="mt-8">
            <a
              href="/contact/"
              class="ezd-focus-ring inline-flex rounded-full bg-white px-5 py-3 text-sm font-semibold text-[var(--ezd-text)] hover:bg-white/90"
            >
              Đặt lịch demo
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>