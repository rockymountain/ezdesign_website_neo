---
import SectionHeader from '../common/SectionHeader.astro';
import Card from '../common/Card.astro';

type SpotlightFeature = {
  title: string;
  description: string;
};

type Props = {
  eyebrow?: string;
  title: string;
  description?: string;
  features: SpotlightFeature[];
};

const {
  eyebrow = 'AI Features',
  title,
  description,
  features,
} = Astro.props as Props;

const spotlightId = `feature-spotlight-${Math.random().toString(36).slice(2)}`;

const getWrappedFeature = (index: number) => {
  const safeIndex = ((index % features.length) + features.length) % features.length;
  return features[safeIndex];
};

const initialActiveIndex = 0;
const initialLeft = getWrappedFeature(initialActiveIndex - 1);
const initialCenter = getWrappedFeature(initialActiveIndex);
const initialRight = getWrappedFeature(initialActiveIndex + 1);
---

<section
  id={spotlightId}
  class="relative overflow-hidden bg-[var(--ezd-accent-soft)] py-20"
  data-feature-spotlight
>
  <div
    class="pointer-events-none absolute inset-0 opacity-80"
    aria-hidden="true"
    style="background:
      radial-gradient(circle at 18% 18%, rgb(35 199 201 / 0.55), transparent 28rem),
      radial-gradient(circle at 80% 28%, rgb(0 87 255 / 0.18), transparent 30rem),
      linear-gradient(180deg, #e7ffff 0%, #f5f7ff 100%);"
  >
  </div>

  <div class="ezd-container relative">
    <SectionHeader
      eyebrow={eyebrow}
      title={title}
      description={description}
      align="center"
      maxWidth="xl"
    />

    <div class="relative mt-12">
      <!-- Desktop arrows -->
      <div class="pointer-events-none absolute inset-y-0 left-0 right-0 z-20 hidden items-center justify-between lg:flex">
        <button
          type="button"
          class="feature-arrow pointer-events-auto -ml-7"
          aria-label="Previous feature"
          data-feature-prev
        >
          <span aria-hidden="true">‹</span>
        </button>

        <button
          type="button"
          class="feature-arrow pointer-events-auto -mr-7"
          aria-label="Next feature"
          data-feature-next
        >
          <span aria-hidden="true">›</span>
        </button>
      </div>

      <div class="grid gap-5 lg:grid-cols-3 lg:items-stretch">
        <!-- Left card: desktop only -->
        <div class="hidden lg:block">
          <Card
            variant="glass"
            padding="lg"
            hover
            class="relative min-h-[340px] overflow-hidden"
          >
            <p
              class="text-xs font-black uppercase tracking-[0.24em] text-[var(--ezd-brand)]"
              data-left-feature-index
            >
              {String(features.length).padStart(2, '0')}
            </p>

            <h3 class="ezd-heading-card mt-4 text-2xl" data-left-feature-title>
              {initialLeft.title}
            </h3>

            <p
              class="ezd-body-small mt-4 text-[var(--ezd-text-muted)]"
              data-left-feature-description
            >
              {initialLeft.description}
            </p>
          </Card>
        </div>

        <!-- Center card: always visible -->
        <Card
          variant="default"
          padding="lg"
          hover
          class="relative mx-auto min-h-[420px] w-full max-w-xl overflow-hidden lg:-mt-6"
          data-feature-card
        >
          <div class="rounded-[var(--ezd-radius-2xl)] bg-[var(--ezd-brand-soft)] p-4">
            <div class="flex min-h-40 items-center justify-center rounded-[var(--ezd-radius-2xl)] border border-[var(--ezd-border)] bg-white/70">
              <div class="text-center">
                <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-[var(--ezd-brand)] text-2xl font-black text-white shadow-[var(--ezd-shadow-md)]">
                  AI
                </div>

                <p class="mt-4 text-xs font-black uppercase tracking-[0.22em] text-[var(--ezd-brand)]">
                  Character Placeholder
                </p>
              </div>
            </div>
          </div>

          <div class="mt-10">
            <p
              class="text-xs font-black uppercase tracking-[0.24em] text-[var(--ezd-brand)]"
              data-center-feature-index
            >
              01
            </p>

            <h3 class="ezd-heading-card mt-4 text-2xl" data-center-feature-title>
              {initialCenter.title}
            </h3>

            <p
              class="ezd-body-small mt-4 text-[var(--ezd-text-muted)]"
              data-center-feature-description
            >
              {initialCenter.description}
            </p>
          </div>
        </Card>

        <!-- Right card: desktop only -->
        <div class="hidden lg:block">
          <Card
            variant="glass"
            padding="lg"
            hover
            class="relative min-h-[340px] overflow-hidden"
          >
            <p
              class="text-xs font-black uppercase tracking-[0.24em] text-[var(--ezd-brand)]"
              data-right-feature-index
            >
              02
            </p>

            <h3 class="ezd-heading-card mt-4 text-2xl" data-right-feature-title>
              {initialRight.title}
            </h3>

            <p
              class="ezd-body-small mt-4 text-[var(--ezd-text-muted)]"
              data-right-feature-description
            >
              {initialRight.description}
            </p>
          </Card>
        </div>
      </div>

      <!-- Mobile arrows -->
      <div class="mt-6 flex justify-center gap-4 lg:hidden">
        <button
          type="button"
          class="feature-arrow feature-arrow--mobile"
          aria-label="Previous feature"
          data-feature-prev
        >
          <span aria-hidden="true">‹</span>
        </button>

        <button
          type="button"
          class="feature-arrow feature-arrow--mobile"
          aria-label="Next feature"
          data-feature-next
        >
          <span aria-hidden="true">›</span>
        </button>
      </div>

      <p class="mt-3 text-center text-xs font-medium text-[var(--ezd-text-soft)] lg:hidden">
        Nhấn mũi tên để xem thêm tính năng.
      </p>
    </div>
  </div>

  <script define:vars={{ spotlightId, features }} is:inline>
    const root = document.getElementById(spotlightId);

    if (root) {
      const items = features;
      const previousButtons = Array.from(root.querySelectorAll('[data-feature-prev]'));
      const nextButtons = Array.from(root.querySelectorAll('[data-feature-next]'));

      let activeIndex = 0;

      const refs = {
        leftIndex: root.querySelector('[data-left-feature-index]'),
        leftTitle: root.querySelector('[data-left-feature-title]'),
        leftDescription: root.querySelector('[data-left-feature-description]'),

        centerIndex: root.querySelector('[data-center-feature-index]'),
        centerTitle: root.querySelector('[data-center-feature-title]'),
        centerDescription: root.querySelector('[data-center-feature-description]'),

        rightIndex: root.querySelector('[data-right-feature-index]'),
        rightTitle: root.querySelector('[data-right-feature-title]'),
        rightDescription: root.querySelector('[data-right-feature-description]'),
      };

      const wrap = (value) => ((value % items.length) + items.length) % items.length;
      const pad = (value) => String(value + 1).padStart(2, '0');

      const updateContent = (nextActiveIndex) => {
        activeIndex = wrap(nextActiveIndex);

        const leftIndex = wrap(activeIndex - 1);
        const centerIndex = wrap(activeIndex);
        const rightIndex = wrap(activeIndex + 1);

        const left = items[leftIndex];
        const center = items[centerIndex];
        const right = items[rightIndex];

        if (refs.leftIndex) refs.leftIndex.textContent = pad(leftIndex);
        if (refs.leftTitle) refs.leftTitle.textContent = left.title;
        if (refs.leftDescription) refs.leftDescription.textContent = left.description;

        if (refs.centerIndex) refs.centerIndex.textContent = pad(centerIndex);
        if (refs.centerTitle) refs.centerTitle.textContent = center.title;
        if (refs.centerDescription) refs.centerDescription.textContent = center.description;

        if (refs.rightIndex) refs.rightIndex.textContent = pad(rightIndex);
        if (refs.rightTitle) refs.rightTitle.textContent = right.title;
        if (refs.rightDescription) refs.rightDescription.textContent = right.description;
      };

      previousButtons.forEach((button) => {
        button.addEventListener('click', () => {
          updateContent(activeIndex - 1);
        });
      });

      nextButtons.forEach((button) => {
        button.addEventListener('click', () => {
          updateContent(activeIndex + 1);
        });
      });

      updateContent(0);
    }
  </script>

  <style>
    .feature-arrow {
      display: inline-flex;
      width: 3.75rem;
      height: 3.75rem;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      background: var(--ezd-accent);
      color: #ffffff;
      box-shadow: var(--ezd-shadow-lg);
      transition:
        background-color 0.2s ease,
        box-shadow 0.2s ease,
        transform 0.2s ease;
    }

    .feature-arrow span {
      display: block;
      font-size: 3.75rem;
      font-weight: 700;
      line-height: 0.72;
      transform: translateY(-0.05em);
    }

    .feature-arrow:hover {
      background: var(--ezd-brand);
      box-shadow: 0 20px 54px rgb(32 38 127 / 0.2);
      transform: translateY(-1px);
    }

    .feature-arrow:active {
      transform: translateY(0) scale(0.98);
    }

    .feature-arrow--mobile {
      width: 3.5rem;
      height: 3.5rem;
    }

    .feature-arrow--mobile span {
      font-size: 3.5rem;
    }
  </style>
</section>