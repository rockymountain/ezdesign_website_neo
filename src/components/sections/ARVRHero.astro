---
import ButtonLink from '../common/ButtonLink.astro';

type CTA = {
  label: string;
  href: string;
};

type Props = {
  eyebrow: string;
  title: string;
  description: string;
  primaryCTA: CTA;
  secondaryCTA: CTA;
};

const { eyebrow, title, description, primaryCTA, secondaryCTA } = Astro.props as Props;
---

<section class="relative overflow-hidden border-b border-[var(--ezd-border)] bg-[var(--ezd-bg-soft)] py-20 md:py-24">
  <div
    class="pointer-events-none absolute inset-0 opacity-90"
    aria-hidden="true"
    style="background:
      radial-gradient(circle at 20% 18%, rgb(35 199 201 / 0.42), transparent 30rem),
      radial-gradient(circle at 84% 28%, rgb(0 87 255 / 0.22), transparent 34rem),
      linear-gradient(180deg, #f5f7ff 0%, #ffffff 100%);"
  >
  </div>

  <div class="ezd-container relative">
    <div class="grid gap-10 lg:grid-cols-[1.02fr_0.98fr] lg:items-center">
      <div>
        <p class="ezd-eyebrow">
          {eyebrow}
        </p>

        <h1 class="ezd-heading-hero mt-5 max-w-4xl text-4xl md:text-6xl">
          {title}
        </h1>

        <p class="ezd-body-large mt-6 max-w-2xl text-[var(--ezd-text-muted)]">
          {description}
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <ButtonLink
            href={primaryCTA.href}
            label={primaryCTA.label}
            variant="primary"
            size="lg"
          />

          <ButtonLink
            href={secondaryCTA.href}
            label={secondaryCTA.label}
            variant="secondary"
            size="lg"
          />
        </div>
      </div>

      <div class="relative rounded-[var(--ezd-radius-2xl)] border border-[var(--ezd-border)] bg-white p-5 shadow-[var(--ezd-shadow-lg)]">
        <div
          class="pointer-events-none absolute -right-20 -top-20 h-64 w-64 rounded-full bg-[var(--ezd-accent)] opacity-20 blur-3xl"
          aria-hidden="true"
        >
        </div>

        <div class="relative grid gap-5 md:grid-cols-2">
          <div class="rounded-[var(--ezd-radius-2xl)] bg-[var(--ezd-bg-soft)] p-5">
            <div class="mx-auto flex h-56 w-36 items-center justify-center rounded-[2rem] border-4 border-[var(--ezd-text)] bg-white shadow-[var(--ezd-shadow-md)]">
              <div class="h-32 w-28 rounded-[var(--ezd-radius-xl)] bg-[linear-gradient(135deg,var(--ezd-brand-soft),var(--ezd-accent-soft))] p-3">
                <div class="flex h-full items-center justify-center rounded-[var(--ezd-radius-lg)] border border-[var(--ezd-brand)] bg-white/70">
                  <span class="text-xl font-black text-[var(--ezd-brand)]">
                    AR
                  </span>
                </div>
              </div>
            </div>

            <p class="mt-5 text-center text-sm font-black text-[var(--ezd-text)]">
              WebAR Preview
            </p>
          </div>

          <div class="grid gap-4">
            <div class="rounded-[var(--ezd-radius-2xl)] bg-[var(--ezd-bg-soft)] p-5">
              <div class="flex h-28 items-center justify-center">
                <div class="relative h-20 w-44 rounded-full border-4 border-[var(--ezd-text)] bg-white shadow-[var(--ezd-shadow-md)]">
                  <div class="absolute left-6 top-5 h-10 w-10 rounded-full bg-[var(--ezd-brand)]"></div>
                  <div class="absolute right-6 top-5 h-10 w-10 rounded-full bg-[var(--ezd-accent)]"></div>
                </div>
              </div>

              <p class="mt-4 text-center text-sm font-black text-[var(--ezd-text)]">
                VR Showcase
              </p>
            </div>

            <div class="rounded-[var(--ezd-radius-2xl)] bg-[var(--ezd-brand)] p-5 text-white">
              <p class="text-xs font-black uppercase tracking-[0.22em] text-white/70">
                MR Concept
              </p>

              <p class="mt-3 text-sm font-bold leading-6">
                Lớp nội dung số đặt lên không gian thật để tạo điểm chạm đáng nhớ.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>