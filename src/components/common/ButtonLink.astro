---
type Props = {
  href: string;
  label: string;
  variant?: 'primary' | 'secondary' | 'dark' | 'ghost' | 'light';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
};

const {
  href,
  label,
  variant = 'primary',
  size = 'md',
  class: className = '',
} = Astro.props as Props;

const sizeClassMap = {
  sm: 'px-4 py-2 text-sm',
  md: 'px-5 py-2.5 text-sm',
  lg: 'px-6 py-3 text-base',
};

const variantClassMap = {
  primary:
    'bg-[var(--ezd-brand)] text-white shadow-[var(--ezd-shadow-sm)] hover:bg-[var(--ezd-brand-dark)]',
  secondary:
    'border border-[var(--ezd-border-strong)] bg-white text-[var(--ezd-text)] hover:bg-[var(--ezd-surface-muted)]',
  dark:
    'bg-[var(--ezd-black)] text-white shadow-[var(--ezd-shadow-sm)] hover:bg-black/90',
  ghost:
    'bg-transparent text-[var(--ezd-text-muted)] hover:bg-[var(--ezd-brand-soft)] hover:text-[var(--ezd-brand-dark)]',
  light:
    'bg-white text-[var(--ezd-text)] shadow-[var(--ezd-shadow-sm)] hover:bg-white/90',
};

const sizeClass = sizeClassMap[size];
const variantClass = variantClassMap[variant];
---

<a
  href={href}
  class:list={[
    'ezd-focus-ring inline-flex items-center justify-center rounded-full font-bold transition',
    sizeClass,
    variantClass,
    className,
  ]}
>
  {label}
</a>