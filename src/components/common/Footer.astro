---
import navigationData from '../../data/navigation.json';
import siteConfig from '../../data/site.json';
import BrandMark from './BrandMark.astro';
import ButtonLink from './ButtonLink.astro';

type NavItem = {
  label: string;
  href: string;
};

const footerNavigation = navigationData.footerNavigation as NavItem[];

const currentYear = new Date().getFullYear();

const contactLinks = [
  {
    label: 'Email',
    value: siteConfig.contact.email,
    href: `mailto:${siteConfig.contact.email}`,
  },
  {
    label: 'Hotline',
    value: siteConfig.contact.hotline,
    href: '/contact/',
  },
  {
    label: 'Zalo',
    value: siteConfig.contact.zalo,
    href: '/contact/',
  },
];
---

<footer class="border-t border-[var(--ezd-border)] bg-[var(--ezd-bg-soft)]">
  <div class="ezd-container py-14">
    <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr_0.8fr]">
      <!-- Brand -->
      <div>
        <BrandMark />

        <p class="mt-5 max-w-md text-sm leading-6 text-[var(--ezd-text-muted)]"> {siteConfig.description} </p>

        <div class="mt-6 flex flex-wrap gap-3">
          <ButtonLink href="/ezd-ai-chat/" label="Xem EZD AI Chat" variant="primary" size="sm" />
          <ButtonLink href="/contact/" label="Đặt lịch demo" variant="secondary" size="sm" />
        </div>
      </div>

      <!-- Footer navigation -->
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.25em] text-[var(--ezd-brand)]">
          Services
        </p>

        <nav class="mt-5 grid gap-3" aria-label="Footer navigation">
          {
            footerNavigation.map((item: NavItem) => (
              <a
                href={item.href}
                class="ezd-focus-ring w-fit rounded-full text-sm font-semibold text-[var(--ezd-text-muted)] transition hover:text-[var(--ezd-text)]"
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>

      <!-- Contact -->
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.25em] text-[var(--ezd-brand)]">
          Contact
        </p>

        <div class="mt-5 grid gap-4">
          {
            contactLinks.map(
              (item: { label: string; value: string; href: string }) => (
                <a
                  href={item.href}
                  class="rounded-[var(--ezd-radius-lg)] border border-[var(--ezd-border)] bg-white p-4 shadow-[var(--ezd-shadow-sm)] transition hover:-translate-y-0.5 hover:shadow-[var(--ezd-shadow-md)]"
                >
                  <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--ezd-text-soft)]">
                    {item.label}
                  </p>
                  <p class="mt-2 text-sm font-semibold text-[var(--ezd-text)]">
                    {item.value}
                  </p>
                </a>
              ),
            )
          }
        </div>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-4 border-t border-[var(--ezd-border)] pt-6 text-sm text-[var(--ezd-text-soft)] md:flex-row md:items-center md:justify-between"
    >
      <p>© {currentYear} {siteConfig.name}. All rights reserved.</p>

      <div class="flex flex-wrap gap-4">
        <a href="/about/" class="hover:text-[var(--ezd-text)]">Về EZDesign</a>
        <a href="/case-studies/yen-ai-chat/" class="hover:text-[var(--ezd-text)]">
          Yên AI Chat
        </a>
        <a href="/contact/" class="hover:text-[var(--ezd-text)]">Liên hệ</a>
      </div>
    </div>
  </div>
</footer>