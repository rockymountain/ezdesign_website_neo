---
type Props = {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  maxWidth?: 'sm' | 'md' | 'lg' | 'xl';
  headingLevel?: 'h1' | 'h2' | 'h3';
};

const {
  eyebrow,
  title,
  description,
  align = 'left',
  maxWidth = 'md',
  headingLevel = 'h2',
} = Astro.props as Props;

const alignmentClass = align === 'center' ? 'mx-auto text-center' : '';

const maxWidthClassMap = {
  sm: 'max-w-xl',
  md: 'max-w-2xl',
  lg: 'max-w-3xl',
  xl: 'max-w-4xl',
};

const maxWidthClass = maxWidthClassMap[maxWidth];

const headingClass =
  headingLevel === 'h1'
    ? 'ezd-heading-hero mt-5 text-4xl md:text-6xl'
    : headingLevel === 'h2'
      ? 'ezd-heading-section mt-4 text-3xl md:text-5xl'
      : 'ezd-heading-card mt-3 text-2xl md:text-3xl';

const HeadingTag = headingLevel;
---

<div class:list={[maxWidthClass, alignmentClass]}>
  {
    eyebrow && (
      <p class="ezd-eyebrow">
        {eyebrow}
      </p>
    )
  }

  <HeadingTag class={headingClass}>{title}</HeadingTag>

  {
    description && (
      <p class="ezd-body-large mt-5 text-[var(--ezd-text-muted)]">
        {description}
      </p>
    )
  }
</div>